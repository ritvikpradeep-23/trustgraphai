# Copy to .env and edit. Every value here is optional; these are the defaults.

# Web pages / extensions allowed to call the API from a browser (comma-separated).
# Add your extension once you know its id, e.g. chrome-extension://abcdefghijklmnop
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000

# --- Scam correlation ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
REPORTS_PATH=data/scam_reports.json
SCAM_HIGH_THRESHOLD=0.82
SCAM_MEDIUM_THRESHOLD=0.68
SCAM_TOP_K=5
MAX_TEXT_CHARS=5000

# --- Deepfake video ---
# TorchScript model file. Leave empty and /api/video/analyze answers 503 model_not_configured.
DEEPFAKE_MODEL_PATH=
# 1 = use a fake model for demos only. Every response it produces says "mock": true.
DEEPFAKE_MOCK=0
DEEPFAKE_INPUT_SIZE=224
VIDEO_MAX_BYTES=52428800
VIDEO_MAX_SECONDS=60
VIDEO_SAMPLE_FPS=1
VIDEO_MAX_FRAMES=30
FACE_MARGIN=0.2
FRAME_FAKE_THRESHOLD=0.5
VIDEO_FAKE_RATIO_THRESHOLD=0.5
