# Replace <password> with the local PostgreSQL password; do not commit .env.
DATABASE_URL=postgresql+psycopg://postgres:<password>@127.0.0.1:5432/trustgraph

# Optional: known-fakes fingerprint matching (app/fingerprint) and /api/media/check limits.
# FINGERPRINT_IMAGE_THRESHOLD=10
# FINGERPRINT_FULL_SCAN_MAX=20000
# MEDIA_MAX_BODY=8388608
# MEDIA_MAX_IMAGE_BYTES=3145728
# MEDIA_MAX_FRAMES=16
