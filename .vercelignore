# Runtime data belongs in PostgreSQL; never upload local secrets or backups.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
/.git/
/.venv/
**/__pycache__
**/*.pyc
**/node_modules
/front end/dist/
/backup/
/backups/
/scratch/
/.claude/
/outputs/
/logs/
# Only public baseline scam runtime files; no training data or rejected models.
/data/*
# The ai/ folder ships only that runtime: the engine code, two model files and
# the precedent reports. No training data, candidates, tests, reports or backups.
/ai/*
!/ai/models/
/ai/models/*
!/ai/models/anomaly_isolation_forest.joblib
!/ai/models/risk_bands.json
!/ai/src/
/ai/src/*
!/ai/src/trustgraph/
!/ai/data/
/ai/data/*
!/ai/data/precedent/
/ai/data/precedent/*
!/ai/data/precedent/reports.json
/trustgraph_extension/
/dist/
