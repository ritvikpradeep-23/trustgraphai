# Runtime data belongs in PostgreSQL; never upload local secrets or backups.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
/.git/
/.venv/
**/__pycache__
**/*.pyc
**/node_modules
/front end/dist/
/backup/
/backups/
/scratch/
/.claude/
/outputs/
/logs/
# Only public baseline scam runtime files; no training data or rejected models.
/data/*
!/data/precedent/
/data/precedent/*
!/data/precedent/reports.json
/models/*
!/models/anomaly_isolation_forest.joblib
!/models/risk_bands.json
/src/*
!/src/trustgraph/
/training/
/routine/
/eval/
/reports/
/runs/
/trustgraph_extension/
/dist/
