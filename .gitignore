.env

# Detectors + accuracy routine: datasets, caches, trained weights and logs stay on your laptop
ai/data/detection/
logs/
ai/models/efficientnet_head.pt
ai/models/text_detector/

# New-scam learning: reported and inbox messages are private, and so are versions built from them
ai/data/learning/
ai/models/candidate/learn_*/
ai/runs/learning_best.json

